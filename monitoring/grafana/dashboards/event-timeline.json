{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Event Timeline",
  "uid": "batch-event-timeline",
  "description": "Visualize reconstructed batch events, their duration, and intensity.",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30d", "to": "now"},
  "refresh": "1m",
  "tags": ["batch", "elasticsearch", "events", "timeline"],
  "timezone": "browser",
  "templating": {"list": []},
  "panels": [
    {
      "type": "table",
      "title": "Event lifecycle summary",
      "id": 1,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "elasticsearch", "uid": "ElasticsearchEvents"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "query": "*",
          "metrics": [
            {"type": "avg", "field": "duration_minutes", "id": "1"},
            {"type": "avg", "field": "intensity", "id": "2"},
            {"type": "min", "field": "start", "id": "3"},
            {"type": "max", "field": "end", "id": "4"}
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "event_name.keyword",
              "id": "5",
              "settings": {"size": 15, "order": "desc", "orderBy": "2", "min_doc_count": 1}
            }
          ]
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event intensity by start time",
      "id": 2,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 10},
      "datasource": {"type": "elasticsearch", "uid": "ElasticsearchEvents"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "query": "*",
          "metrics": [{"type": "avg", "field": "intensity", "id": "1"}],
          "bucketAggs": [
            {"type": "date_histogram", "field": "start", "id": "2", "settings": {"interval": "auto", "min_doc_count": 0}}
          ]
        }
      ]
    }
  ]
}
