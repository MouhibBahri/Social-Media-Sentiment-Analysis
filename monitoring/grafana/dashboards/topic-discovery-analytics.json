{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Batch Topic Discovery Analytics",
  "uid": "batch-topic-discovery",
  "description": "Historical topic discovery views computed from immutable HDFS batch recomputation and indexed into Elasticsearch.",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30d", "to": "now"},
  "refresh": "1m",
  "tags": ["batch", "elasticsearch", "topics", "historical"],
  "timezone": "browser",
  "templating": {"list": []},
  "panels": [
    {
      "type": "timeseries",
      "title": "Topic volume evolution over time",
      "id": 1,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "elasticsearch", "uid": "ElasticsearchTopics"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "query": "*",
          "metrics": [{"type": "count", "id": "1"}],
          "bucketAggs": [
            {"type": "date_histogram", "field": "run_at", "id": "2", "settings": {"interval": "auto", "min_doc_count": 0}}
          ]
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top keywords per discovered topic",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "elasticsearch", "uid": "ElasticsearchTopics"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "query": "*",
          "metrics": [{"type": "avg", "field": "count", "id": "1"}],
          "bucketAggs": [
            {"type": "terms", "field": "topic_keywords_text.keyword", "id": "2", "settings": {"size": 10, "order": "desc", "orderBy": "_count", "min_doc_count": 1}}
          ]
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Topic distribution across the dataset",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "elasticsearch", "uid": "ElasticsearchTopics"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "query": "*",
          "metrics": [{"type": "count", "id": "1"}],
          "bucketAggs": [
            {"type": "terms", "field": "topic_name.keyword", "id": "2", "settings": {"size": 10, "order": "desc", "orderBy": "_count", "min_doc_count": 1}}
          ]
        }
      ]
    }
  ]
}